{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "standalone-debug",
            "inherits": "base",
            "displayName": "Standalone Debug (clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "standalone-release",
            "inherits": "base",
            "displayName": "Standalone Release (clang)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "web-debug",
            "inherits": "base",
            "displayName": "Web Debug (emscripten)",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "web-release",
            "inherits": "base",
            "displayName": "Web Release (emscripten)",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "standalone-debug",
            "configurePreset": "standalone-debug"
        },
        {
            "name": "standalone-release",
            "configurePreset": "standalone-release"
        },
        {
            "name": "web-debug",
            "configurePreset": "web-debug"
        },
        {
            "name": "web-release",
            "configurePreset": "web-release"
        }
    ]
}